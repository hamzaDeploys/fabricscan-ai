# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ---- Raw photos: too large for GitHub and they carry EXIF metadata.
#      Only the folder skeleton, README and capture log are tracked. ----
dataset/**
!dataset/*/
!dataset/*/.gitkeep
!dataset/README.md
!dataset/capture_log.csv
!dataset/SOURCES.csv
/field_test/

# ---- Generated by the scripts (rebuilt any time) ----
/data/

# ---- Trained models (published as GitHub Release assets).
#      The browser model in web/public/models/ IS committed. ----
/models/

# ---- Web app ----
web/node_modules/
web/dist/
.vercel/

# ---- Personal to-do list (not part of the project) ----
MY_TASKS.md

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log

# Training console output (contains local paths); the metrics are in results/metrics/.
results/train_log.txt
